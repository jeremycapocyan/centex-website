# Server-only Microsoft 365 app credentials. Configure these in Vercel.
# Never use NEXT_PUBLIC_ prefixes for these values.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Enable only after an administrator authorizes getcovered@centexis.com.
QUOTE_FORM_ENABLED=false

# Public SEO configuration. Change SITE_URL only when that domain serves this site.
SITE_URL=https://centex-website-omce.vercel.app
# Optional Google Search Console HTML-tag verification content value.
GOOGLE_SITE_VERIFICATION=
